{
  "name": "sky-first-research-center",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.dev.vars scripts/local.mjs",
    "build": "node scripts/build.mjs && wrangler pages functions build --outdir .build/pages",
    "test": "node --test tests/*.test.mjs",
    "seed": "node --env-file-if-exists=.dev.vars scripts/seed.mjs",
    "deploy:data": "wrangler deploy --config wrangler.data.jsonc",
    "deploy:app": "wrangler deploy --config wrangler.app.jsonc",
    "deploy:single": "wrangler deploy --config wrangler.worker.jsonc",
    "configure": "node --env-file-if-exists=.dev.vars scripts/configure.mjs",
    "test:browser": "node tests/browser.mjs",
    "dev:pages": "wrangler pages dev public",
    "deploy:pages": "npm run build && wrangler pages deploy public",
    "migrate:local": "wrangler d1 migrations apply tt --local",
    "migrate:production": "wrangler d1 migrations apply tt --remote",
    "test:pages": "node tests/pages.mjs"
  },
  "devDependencies": {
    "playwright": "1.62.1",
    "wrangler": "4.34.0"
  }
}
