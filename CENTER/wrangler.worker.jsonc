{
  "name": "sfrc",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "vars": {
    "MODE": "single",
    "APP_ORIGIN": "https://research.skyfirst.io.vn"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tt",
      "database_id": "0a75531f-b227-4a8b-bc26-dda1cc9a0004",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "STORAGE",
      "bucket_name": "ttrungtam"
    }
  ],
  "triggers": {
    "crons": [
      "0 1 * * *"
    ]
  }
}
